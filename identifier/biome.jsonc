{
  // This file must be named biome.jsonc, not biome.json. Comments in a file
  // named biome.json are not reported as an error: Biome silently discards the
  // whole configuration and runs on defaults instead.
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "files": {
    // Scoped explicitly rather than through ignore files, so an untracked
    // directory in a working tree cannot change what lint reports. These
    // exclusions carry over the ones .eslintignore used to hold, plus the
    // locale JSON that make -C i18n generates from the .po files.
    "includes": [
      "**",
      // Bare folder names, not "folder/**": that lets the scanner skip the
      // directory instead of matching every path inside it.
      "!build",
      "!dist",
      "!coverage",
      "!releases",
      "!tests",
      "!src/locales/locales.json",
      "!src/locales/*/translation.json",
      // The SVGs are image assets, reached by URL from CSS and from an img tag,
      // never inlined into JSX. Biome's SVG rules assume the inline case, so
      // they ask a background image for a title element. src/images/app-icon.svg
      // is also generated by src/images/Makefile and gitignored, and linting a
      // file that may or may not exist in a working tree is exactly what the
      // explicit scoping above is meant to prevent.
      "!**/*.svg"
    ]
  },

  "formatter": {
    // Off deliberately. This project has never had a formatter, so enabling one
    // would rewrite every file and bury the linter swap in mechanical noise.
    // The settings below are correct for the codebase, so turning this on is a
    // one-line decision whenever a reformat is actually wanted.
    "enabled": false,
    "useEditorconfig": true,
    // Biome does not read max_line_length from .editorconfig, so the width has
    // to live here even with useEditorconfig on. 120 is what the repository's
    // root ESLint config asked for.
    "lineWidth": 120
  },

  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      // "preset" supersedes the deprecated "recommended": true.
      "preset": "recommended"
    }
  },

  "assist": {
    // Import sorting would reorder every file's imports, which is the same
    // mechanical churn as the formatter. Left off for the same reason.
    "enabled": false
  }
}
